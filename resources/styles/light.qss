* {
    font-family: "Segoe UI", "Ubuntu", "Noto Sans", sans-serif;
    font-size: 10pt;
    color: #1A202C;
    outline: none;
}

QMainWindow,
QWidget {
    background-color: #F0F2F5;
}

QFrame#frm_leftmenu {
    background-color: #FFFFFF;
    border: none;
    border-right: 1px solid #E2E8F0;
    border-radius: 0px;
}

QFrame#frm_mainmenu {
    background-color: #F0F2F5;
    border: none;
    border-radius: 0px;
}

QStackedWidget {
    background-color: #F0F2F5;
    border: none;
}

QFrame#frm_leftmenu QLabel#lbl_logo {
    color: #1A202C;
    font-size: 15pt;
    font-weight: 700;
    padding: 8px 0 20px 0;
    background: transparent;
    border: none;
}

QFrame#frm_leftmenu QPushButton {
    background-color: transparent;
    color: #4A5568;
    border: none;
    border-radius: 8px;
    text-align: left;
    padding: 0 14px;
    min-height: 42px;
    font-size: 10pt;
    font-weight: 500;
}

QFrame#frm_leftmenu QPushButton:hover {
    background-color: #EDF2F7;
    color: #1A202C;
}

QFrame#frm_leftmenu QPushButton:checked {
    background-color: #EBF4FF;
    color: #2B6CB0;
    border-left: 3px solid #3182CE;
    padding-left: 11px;
}

QFrame#frm_leftmenu QPushButton#btn_logout {
    color: #C53030;
}

QFrame#frm_leftmenu QPushButton#btn_logout:hover {
    background-color: #FFF5F5;
    color: #9B2C2C;
}

QFrame {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

QLabel {
    background: transparent;
    border: none;
    color: #1A202C;
}

QLabel#lbl_title {
    font-size: 20pt;
    font-weight: 700;
    color: #1A202C;
    padding-bottom: 2px;
}

QLabel#lbl_subtitle {
    font-size: 10pt;
    color: #718096;
    padding-bottom: 8px;
}

QPushButton {
    background-color: #EDF2F7;
    color: #2D3748;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 8px 16px;
    min-height: 34px;
    font-weight: 500;
    text-align: center;
}

QPushButton:hover {
    background-color: #E2E8F0;
    border-color: #CBD5E0;
    color: #1A202C;
}

QPushButton:pressed {
    background-color: #CBD5E0;
}

QPushButton#btn_save,
QPushButton#btn_login,
QPushButton#btn_filter {
    background-color: #2B6CB0;
    border: 1px solid #2B6CB0;
    color: #FFFFFF;
}

QPushButton#btn_save:hover,
QPushButton#btn_login:hover,
QPushButton#btn_filter:hover {
    background-color: #3182CE;
    border-color: #3182CE;
}

QPushButton#btn_save:pressed,
QPushButton#btn_login:pressed,
QPushButton#btn_filter:pressed {
    background-color: #2C5282;
}

QPushButton#btn_delete {
    background-color: #FFF5F5;
    border: 1px solid #FEB2B2;
    color: #C53030;
}

QPushButton#btn_delete:hover {
    background-color: #FED7D7;
    border-color: #FC8181;
    color: #9B2C2C;
}

QPushButton#btn_clear,
QPushButton#btn_register {
    background-color: transparent;
    border: 1px solid #CBD5E0;
    color: #4A5568;
}

QPushButton#btn_clear:hover,
QPushButton#btn_register:hover {
    background-color: #EDF2F7;
    border-color: #A0AEC0;
    color: #1A202C;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit {
    background-color: #FFFFFF;
    color: #1A202C;
    border: 1px solid #CBD5E0;
    border-radius: 8px;
    padding: 8px 12px;
    min-height: 20px;
    selection-background-color: #2B6CB0;
    selection-color: #FFFFFF;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus {
    border: 1px solid #3182CE;
    background-color: #FFFFFF;
}

QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover {
    border-color: #A0AEC0;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #718096;
    width: 0;
    height: 0;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    selection-background-color: #EBF4FF;
    selection-color: #1A202C;
    padding: 4px;
    outline: none;
}

QDateEdit::drop-down {
    border: none;
    width: 28px;
}

QCheckBox {
    spacing: 8px;
    color: #1A202C;
    background: transparent;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #CBD5E0;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #3182CE;
}

QCheckBox::indicator:checked {
    background-color: #2B6CB0;
    border-color: #2B6CB0;
}

QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F7FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    gridline-color: #E2E8F0;
    selection-background-color: #EBF4FF;
    selection-color: #1A202C;
}

QTableWidget::item {
    padding: 8px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #EBF4FF;
    color: #1A202C;
}

QHeaderView {
    background-color: transparent;
}

QHeaderView::section {
    background-color: #F7FAFC;
    color: #4A5568;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    padding: 10px 8px;
    font-weight: 600;
    font-size: 9pt;
}

QHeaderView::section:horizontal {
    border-right: 1px solid #E2E8F0;
}

QTableCornerButton::section {
    background-color: #F7FAFC;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px 4px 0;
}

QScrollBar::handle:vertical {
    background: #CBD5E0;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #A0AEC0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0 4px 2px 4px;
}

QScrollBar::handle:horizontal {
    background: #CBD5E0;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #A0AEC0;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}

QToolTip {
    background-color: #FFFFFF;
    color: #1A202C;
    border: 1px solid #3182CE;
    border-radius: 6px;
    padding: 6px 10px;
}

QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #1A202C;
}

QMessageBox QPushButton {
    min-width: 80px;
    min-height: 32px;
}

QCalendarWidget {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #1A202C;
    border: none;
    border-radius: 4px;
    padding: 4px;
    margin: 2px;
}

QCalendarWidget QToolButton:hover {
    background-color: #EDF2F7;
}

QCalendarWidget QAbstractItemView {
    background-color: #FFFFFF;
    selection-background-color: #2B6CB0;
    selection-color: #FFFFFF;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #F7FAFC;
}